# Settings shared by the dev container (scripts/amr) and the zenoh bridge (compose.zenoh.yml).
# Changing them needs `scripts/amr down` and a restart.

# Own DDS domain, so ROS machines on the same network (default domain 0) don't leak into the robot's graph.
ROS_DOMAIN_ID=42
# CycloneDDS, not the image's Fast DDS: zenoh-bridge-ros2dds is Cyclone-based and Fast DDS <-> Cyclone services
# (/amr/set_mode, /amr/save_map, ...) never get a reply. Everything that talks to the robot must use the same RMW.
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
