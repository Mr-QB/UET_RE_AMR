# Extra `docker run` args for run_dev.sh (see docker/README.md).
# Only add what run_dev.sh doesn't already do by default (DISPLAY, network
# host, ROS_DOMAIN_ID are already handled) -- do not add `-e DISPLAY=$DISPLAY`
# here, it breaks docker run when $DISPLAY is unset.

# Serial links, by the stable names from hardware/udev/ (each is dropped if not plugged in)
--device=/dev/esp32
--device=/dev/rplidar

# Same RMW as docker-dev.sh's long-lived container (the zenoh bridge is Cyclone-based; Fast DDS services can't reach it)
-e RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# nvblox is the default local costmap in this container (see amr_bringup.launch.py's use_nvblox)
-e UET_AMR_NVBLOX=true
