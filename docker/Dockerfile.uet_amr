# UET AMR development layer, stacked on NVIDIA's isaac_ros_common layers via its own mechanism
# (CONFIG_DOCKER_SEARCH_DIRS + image key "...uet_amr", see scripts/lib/devenv.sh).
# Adds the workspace's apt dependencies (nvblox, nitros, nav2, rplidar_ros, ...) so they are baked
# into the image instead of reinstalled by rosdep in every new container.
# .pkgxml/ (package.xml files only) is generated by scripts/lib/devenv.sh, so this layer only
# rebuilds when a dependency changes -- not on code changes.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-c"]
COPY .pkgxml /tmp/pkgxml
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update --allow-releaseinfo-change && source /opt/ros/humble/setup.bash && \
    (rosdep update || true) && \
    rosdep install --from-paths /tmp/pkgxml --ignore-src -r -y && \
    # the base's ROS snapshot is older than apt: robot_localization needs a newer diagnostic_updater
    apt-get install -y --only-upgrade ros-humble-diagnostic-updater && \
    rm -rf /tmp/pkgxml /var/lib/apt/lists/*
