<xacro:depth_camera parent="base_link"
                    update_rate="30"
                    horizontal_fov="1.518"
                    image_width="848"
                    image_height="480"
                    clip_near="0.1"
                    clip_far="10.0"
                    frame_id="camera_link"
                    topic_name="camera"
                    imu_update_rate="100"
                    imu_topic_name="imu/data">
  <origin xyz="0.25 0.0 0.08" rpy="0 0 0"/>
</xacro:depth_camera>

