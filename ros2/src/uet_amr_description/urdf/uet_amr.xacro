<?xml version="1.0" ?>
<robot name="uet_amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:arg name="use_real_hardware" default="false"/>

<xacro:include filename="$(find uet_amr_description)/urdf/materials.xacro" />
<xacro:include filename="$(find uet_amr_description)/urdf/sensors/lidar.xacro" />
