</xacro:unless>
<xacro:include filename="$(find uet_amr_description)/urdf/uet_amr.gazebo" />

<link name="base_link">
  <inertial>
    <origin xyz="0.0025532775935351716 0.0007810393984697188 -0.007616605165089496" rpy="0 0 0"/>
    <mass value="9.278155762193999"/>
