<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="lidar" params="frame_id parent *origin">
        <link name="${frame_id}">
            <visual>
                <geometry>
                    <cylinder length="0.04" radius="0.038"/>
                </geometry>
                <material name="blue">
                    <color rgba="0.0 0.4 0.8 1.0"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder length="0.04" radius="0.038"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.185"/>
                <inertia ixx="0.0000914" ixy="0" ixz="0" iyy="0.0000914" iyz="0" izz="0.0001335"/>
            </inertial>
        </link>

        <joint name="${frame_id}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${frame_id}"/>
            <xacro:insert_block name="origin"/>
        </joint>

    </xacro:macro>
</robot>
