<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uet_amr_navigation</name>
  <version>0.1.0</version>
  <description>Nav2-based navigation stack configuration for UET AMR</description>
  <maintainer email="robotics@uet.vnu.edu.vn">Department of Robotics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>uet_amr_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Local costmap plugin (nvblox_nav2::NvbloxCostmapLayer), loaded by class name from nav2.yaml; nvblox itself runs from uet_amr_perception. -->
  <exec_depend>nvblox_nav2</exec_depend>
  <exec_depend>uet_amr_perception</exec_depend>
  <exec_depend>uet_amr_maps</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
