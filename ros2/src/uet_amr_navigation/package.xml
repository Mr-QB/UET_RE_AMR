<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uet_amr_navigation</name>
  <version>0.1.0</version>
  <description>Nav2-based navigation stack configuration for UET AMR</description>
  <maintainer email="robotics@uet.vnu.edu.vn">Department of Robotics</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_costmap_2d</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>uet_amr_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Runtime-optional: only used when navigation.launch.py's use_nvblox:=true
       (default when an NVIDIA GPU is detected). Not a build dependency, since
       nvblox_nav2's costmap plugin is loaded by class name string at
       runtime, so this package builds fine even when nvblox_ros/nvblox_nav2
       are skipped (no GPU; see scripts/common.sh). -->
  <exec_depend>nvblox_ros</exec_depend>
  <exec_depend>nvblox_nav2</exec_depend>
  <exec_depend>nvblox_msgs</exec_depend>

  <!-- Runtime-optional: people segmentation for nvblox (navigation.launch.py use_detection:=true). PeopleSemSegNet
       U-Net on the colour image -> mask nvblox leaves out of the static map. The model itself is not an apt
       package payload: run isaac_ros_peoplesemseg_models_install once inside the container to download it and
       build the TensorRT engine (see docs/isaac_ros_setup.md). -->
  <exec_depend>isaac_ros_unet</exec_depend>
  <exec_depend>isaac_ros_tensor_rt</exec_depend>
  <exec_depend>isaac_ros_dnn_image_encoder</exec_depend>
  <exec_depend>isaac_ros_peoplesemseg_models_install</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
