# Reduced to the D435 / D435i / D455 used on this robot.
# Intel RealSense D435 / D435i / D455: user-level USB access (librealsense RSUSB backend)
SUBSYSTEMS=="usb", ATTRS{idVendor}=="8086", ATTRS{idProduct}=="0b07|0b3a|0b5c", MODE:="0666", GROUP:="plugdev"
